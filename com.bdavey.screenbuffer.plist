<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bdavey.screenbuffer</string>
	<!-- __EXEC__ is replaced with the installed binary path by `make install`. -->
	<key>ProgramArguments</key>
	<array>
		<string>__EXEC__</string>
	</array>
	<!-- Start at login and relaunch if it ever exits: "always running". -->
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardOutPath</key>
	<string>/tmp/screenbuffer.out.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/screenbuffer.err.log</string>
</dict>
</plist>
